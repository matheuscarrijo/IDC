# Relatórios: somente os PDFs finais mensais são versionados.
# Fontes LaTeX, arquivos de construção, DOCX, templates, imagens e auditorias
# permanecem locais, inclusive logo.png, index.png e components_raw.png.
outputs/report/*
!outputs/report/update-*/
outputs/report/update-*/*
!outputs/report/update-*/idc-update-*.pdf

# BCB raw data (reproduzível via download_bcb_release.py)
data/raw/

# Python
__pycache__/
*.pyc
*.pyo
.venv/
*.egg-info/

# Local tooling
.claude/

# macOS
.DS_Store

# Excel temp files
~$*
